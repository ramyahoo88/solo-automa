<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>A Glorious Chance – Solo Companion v0.2.18</title>
<style>
:root {
  --bg: #f3efe6; --panel: #fffdf8; --ink: #1f2a33; --muted: #52606b; --line: #d9d1c2;
  --us: #2f5f9e; --us-soft: #dbe7f6; --br: #a8322d; --br-soft: #f6dddb; --gold: #b58a2b;
  --water: #cfe3ee; --water2: #b9d6e6; --ok: #2e7d4f; --warn: #b26b00; --bad: #a8322d;
  --radius: 8px; --shadow: 0 1px 3px rgba(0,0,0,.12);
  font-size: 15px;
}
* { box-sizing: border-box; }
html, body { margin: 0; padding: 0; background: var(--bg); color: var(--ink); font-family: Georgia, 'Iowan Old Style', 'Palatino Linotype', serif; }
button, select, input { font-family: inherit; font-size: .95rem; }
button { cursor: pointer; border: 1px solid #9aa4ad; background: #fff; color: var(--ink); border-radius: 6px; padding: 6px 12px; }
button:hover { background: #f1f4f6; }
button.primary { background: #234a73; border-color: #234a73; color: #fff; }
button.primary:hover { background: #1b3a5b; }
button:disabled { opacity: .45; cursor: not-allowed; }
button.small { padding: 3px 8px; font-size: .82rem; }
button:focus-visible, input:focus-visible, select:focus-visible, textarea:focus-visible { outline: 3px solid var(--gold); outline-offset: 2px; }
.muted { color: var(--muted); }
.us { color: var(--us); } .br { color: var(--br); }

/* Header */
#hdr { position: sticky; top: 0; z-index: 20; background: #1f2f3e; color: #f4efe2; padding: 6px 12px; display: flex; flex-wrap: wrap; align-items: center; gap: 10px 18px; box-shadow: 0 2px 6px rgba(0,0,0,.25); }
#hdr h1 { font-size: 1.05rem; margin: 0; letter-spacing: .5px; font-variant: small-caps; white-space: nowrap; }
.app-version { font-size: .75rem; color: #b8c4cf; }
#hdr .stat { display: flex; flex-direction: column; line-height: 1.15; font-size: .8rem; }
#hdr .stat b { font-size: 1rem; }
#hdr .btns { margin-left: auto; display: flex; gap: 6px; flex-wrap: wrap; }
#hdr .btns button { background: #2f4458; color: #f4efe2; border-color: #4b6176; padding: 4px 10px; font-size: .85rem; }
#hdr .btns button:hover { background: #3b566f; }
.turntrack { display: flex; flex-wrap: wrap; gap: 2px; }
.turntrack span { font-size: .68rem; padding: 2px 4px; border-radius: 3px; background: #2f4458; color: #b8c4cf; }
.turntrack span.cur { background: var(--gold); color: #1f2a33; font-weight: bold; }
.turntrack span.past { color: #c5d0d8; background: #293b4b; }

/* Layout */
#app { display: grid; grid-template-columns: minmax(380px, 520px) 1fr; gap: 12px; padding: 12px; align-items: start; }
@media (max-width: 1000px) { #app { grid-template-columns: 1fr; } }
.panel { background: var(--panel); border: 1px solid var(--line); border-radius: var(--radius); box-shadow: var(--shadow); padding: 12px; }
.panel h2 { margin: 0 0 6px; font-size: 1.05rem; font-variant: small-caps; letter-spacing: .3px; }
.panel h3 { margin: 10px 0 4px; font-size: .95rem; }
#proc { position: sticky; top: 64px; max-height: calc(100vh - 80px); overflow: auto; }
#proc .step { font-size: .78rem; color: var(--muted); text-transform: uppercase; letter-spacing: .6px; }
#proc .ptitle { font-size: 1.15rem; margin: 2px 0 8px; font-weight: bold; }
#proc .ptext { white-space: pre-wrap; line-height: 1.4; margin-bottom: 10px; }
#proc .opts { display: flex; flex-wrap: wrap; gap: 8px; margin-top: 8px; }
#proc .err { color: var(--bad); font-size: .88rem; margin-top: 6px; min-height: 1.2em; }
.optcard { border: 1px solid var(--line); border-radius: 8px; padding: 8px 10px; margin: 6px 0; cursor: pointer; background: #fff; }
button.optcard { display: block; width: 100%; text-align: left; }
.optcard .t, .optcard .d { display: block; }
.optcard:hover { border-color: #234a73; background: #f4f8fc; }
.optcard .t { font-weight: bold; }
.optcard .d { font-size: .85rem; color: #3d4852; margin-top: 2px; }
.tac-white { border-left: 8px solid #e4e4e4; } .tac-lavender { border-left: 8px solid #b9a6c9; } .tac-salmon { border-left: 8px solid #d7a395; }
.tac-yellow { border-left: 8px solid #e9e33a; } .tac-teal { border-left: 8px solid #8fbfc1; } .tac-green { border-left: 8px solid #8aaa86; }

/* Lake */
#lake { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); grid-template-areas: "YOR NOR KIN" "NIA SOU SAC"; gap: 6px; background: linear-gradient(160deg, var(--water), var(--water2)); padding: 8px; border-radius: 10px; }
.zone { background: rgba(255,255,255,.55); border: 1px solid rgba(40,80,110,.35); border-radius: 8px; padding: 6px; min-width: 0; min-height: 120px; position: relative; }
.zone.ctl-US { box-shadow: inset 0 0 0 3px var(--us); }
.zone.ctl-BR { box-shadow: inset 0 0 0 3px var(--br); }
.zone.enc { outline: 3px dashed var(--gold); }
.zone .zh { display: flex; flex-wrap: wrap; gap: 2px 5px; justify-content: space-between; align-items: center; font-weight: bold; font-size: .9rem; margin-bottom: 4px; }
.zone .tags { display: flex; gap: 4px; flex-wrap: wrap; margin-bottom: 4px; }
.tag { font-size: .7rem; padding: 1px 6px; border-radius: 10px; background: #eee; border: 1px solid #ccc; overflow-wrap: anywhere; }
.tag.us { background: var(--us-soft); border-color: var(--us); color: var(--us); }
.tag.br { background: var(--br-soft); border-color: var(--br); color: var(--br); }
.tag.ev { background: #fff6dc; border-color: #d9b34a; color: #7a5a00; }
.tag.pe { background: #fff; border-color: #333; color: #333; }
.tag.blk { background: #333; color: #fff; border-color: #000; }
.force { border: 1px solid rgba(0,0,0,.15); border-radius: 6px; padding: 3px; margin-top: 4px; background: rgba(255,255,255,.7); }
.force .fh { font-size: .72rem; font-weight: bold; margin-bottom: 2px; }
.force.US .fh { color: var(--us); } .force.BR .fh { color: var(--br); }

/* Ships */
.ships { display: flex; flex-wrap: wrap; gap: 3px; }
.ship { text-align: left; display: inline-flex; justify-content: center; flex-direction: column; min-width: 92px; max-width: 132px; border-radius: 5px; padding: 2px 5px; font-size: .72rem; line-height: 1.15; border: 1px solid; background: #fff; }
.ship.US { border-color: var(--us); background: #eef4fb; }
.ship.BR { border-color: var(--br); background: #fbefee; }
.ship.red { background: repeating-linear-gradient(45deg, #fff, #fff 4px, #f1f1f1 4px, #f1f1f1 8px); border-style: dashed; }
.ship .nm { font-weight: bold; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.ship .st { font-family: ui-monospace, Menlo, Consolas, monospace; font-size: .68rem; color: #333; }
.ship .no-steps { color: #702015; background: #fff3cd; border-radius: 3px; padding: 2px; margin-top: 2px; font-weight: bold; }
.ship .fl { color: var(--gold); }
.ship.flag { box-shadow: 0 0 0 2px var(--gold); }
.ship.sel { box-shadow: 0 0 0 3px #234a73; }
.dots { letter-spacing: 1px; }

/* Homeports */
.ports { display: grid; grid-template-columns: 1fr 1fr; gap: 10px; margin-top: 10px; }
@media (max-width: 1300px) { .ports { grid-template-columns: 1fr; } }
.port { border-radius: 8px; padding: 6px; }
.port.US { background: #e9f0f8; border: 1px solid #b7c9de; }
.port.BR { background: #f8eceb; border: 1px solid #e0bdb9; }
.port h3 { margin: 0 0 4px; font-size: .9rem; }
.box { margin: 3px 0; }
.box .bl { font-size: .7rem; text-transform: uppercase; letter-spacing: .5px; color: var(--muted); }

/* Tracks */
.tracks { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 16rem), 1fr)); gap: 6px 14px; font-size: .85rem; margin-top: 8px; }
.trk { display: flex; flex-wrap: wrap; gap: 2px; align-items: center; }
.tracks > div { min-width: 0; overflow-wrap: anywhere; }
.trk i { display: inline-block; width: 15px; height: 15px; font-size: .62rem; text-align: center; line-height: 15px; border: 1px solid #c9c0ae; background: #fff; font-style: normal; color: #52606b; }
.trk i.on.US { background: var(--us); color: #fff; border-color: var(--us); }
.trk i.on.BR { background: var(--br); color: #fff; border-color: var(--br); }
.trk i.tr { border-color: #6a8f3c; }
.niag { display: flex; gap: 2px; }
.niag span { font-size: .62rem; padding: 2px 3px; border: 1px solid #ccc; background: #fff; border-radius: 3px; }
.niag span.on { background: var(--gold); color: #17212a; border-color: var(--gold); }

/* Cards */
.cardrow { display: flex; gap: 4px; flex-wrap: wrap; margin-top: 6px; }
.tcard { width: 86px; min-height: 52px; border-radius: 6px; border: 1px solid #b9b9b9; font-size: .68rem; padding: 3px; background: #f7f7f7; }
.tcard.back { background: linear-gradient(135deg, #e0e9ef, #c7d8e3); }
.tcard.rev { background: #fff; text-align: left; }
.tcard > span { display: block; }
.tcard.removed { border-style: dashed; }
.tcard .z { font-weight: bold; }
.evcard { border: 1px solid #c9b78f; border-radius: 8px; background: #fffaf0; padding: 6px 8px; margin: 6px 0; font-size: .85rem; }
.evcard .top { display: flex; justify-content: space-between; font-weight: bold; }
.evcard .mid { margin: 4px 0; padding: 3px 6px; background: #eee; border-radius: 4px; display: flex; justify-content: space-between; }
.evcard .wgA { color: #fff; background: var(--us); padding: 0 6px; border-radius: 8px; }
.evcard .wgB { color: #fff; background: var(--br); padding: 0 6px; border-radius: 8px; }
.tgt { border: 1px solid #aaa; border-radius: 8px; padding: 6px 8px; margin: 6px 0; background: #fff; font-size: .82rem; }
.tgt table { border-collapse: collapse; margin-top: 4px; }
.tgt td, .tgt th { border: 1px solid #bbb; padding: 1px 4px; text-align: center; font-size: .7rem; }
.tgt td.hit { background: #f3d7a6; font-weight: bold; }
.tgt td.cur { outline: 3px solid #234a73; outline-offset: -2px; }

/* Combat view */
#proc .combat { display: grid; grid-template-columns: 1fr 1fr; gap: 8px; margin-top: 8px; }
.combat .colm { border-radius: 8px; padding: 6px; }
.combat .colm.US { background: #eef4fb; } .combat .colm.BR { background: #fbefee; }
.combat .pos { display: flex; align-items: center; gap: 6px; margin: 2px 0; font-size: .82rem; }
.combat .pos b { width: 18px; text-align: right; }
.combat .gap { color: var(--muted); font-style: italic; }

/* Selection lists */
.sel-list { display: flex; flex-direction: column; gap: 3px; max-height: 360px; overflow: auto; border: 1px solid var(--line); border-radius: 6px; padding: 6px; background: #fff; }
.sel-list label { display: flex; gap: 6px; align-items: center; font-size: .9rem; }
.lineup-row, .asg-heading { display: flex; flex-wrap: wrap; align-items: center; gap: 5px; }
.sel-group { font-weight: bold; font-size: .8rem; margin-top: 6px; color: #234a73; }

/* Assign editor */
.asg-force { border: 1px solid var(--line); border-radius: 8px; padding: 6px; margin: 6px 0; background: #fff; }
.asg-force .row { display: flex; flex-wrap: wrap; gap: 6px; align-items: center; }
.asg-ships { display: flex; flex-wrap: wrap; gap: 4px; margin-top: 6px; }
.asg-ship { border: 1px solid #b7c9de; border-radius: 5px; padding: 2px 6px; font-size: .8rem; background: #f6f9fd; cursor: pointer; }
.asg-ship.on { background: #234a73; color: #fff; border-color: #234a73; }
.asg-ship.taken { opacity: .35; }

/* Log */
#log { max-height: 340px; overflow: auto; font-size: .82rem; font-family: ui-monospace, Menlo, Consolas, monospace; background: #fbfaf6; border: 1px solid var(--line); border-radius: 6px; padding: 6px; }
#log div { padding: 1px 0; border-bottom: 1px dotted #eee; white-space: pre-wrap; }
#log .turn { font-weight: bold; color: #234a73; }
#log .vp { color: #7a5a00; } #log .roll { color: #333; } #log .ai { color: var(--br); } #log .player { color: var(--us); } #log .combat { color: #4b2c62; }

/* Modal */
#modal { position: fixed; inset: 0; background: rgba(0,0,0,.45); display: none; align-items: center; justify-content: center; z-index: 50; }
#modal.open { display: flex; }
#modal .inner { background: var(--panel); border-radius: 10px; max-width: 900px; width: 94vw; max-height: 88vh; overflow: auto; padding: 16px; }
#modal .inner > div:first-child { position: sticky; top: 0; z-index: 2; background: var(--panel); padding: 3px 0; }
.modal-controls { display: flex; justify-content: flex-end; gap: 8px; }
.modal-controls button:first-child:not(:last-child) { margin-right: auto; }
.ref-topic { max-width: 100%; overflow-x: auto; }
.ref select { max-width: 100%; }
.ref caption { text-align: left; font-weight: bold; margin: 4px 0; }
#modal label { display: block; margin: 8px 0; }
.ref table { border-collapse: collapse; font-size: .82rem; margin: 6px 0 12px; }
.ref td, .ref th { border: 1px solid #c9c0ae; padding: 2px 6px; text-align: center; }
.ref th { background: #efe9dc; }

/* Setup */
.setup { max-width: 760px; margin: 30px auto; }
.setup .camp { display: grid; grid-template-columns: 1fr 1fr; gap: 12px; }
.setup .camp button { padding: 18px; font-size: 1.05rem; text-align: left; }
.setup .camp button.on { outline: 3px solid var(--gold); }
.setup label { display: block; margin: 6px 0; }
.banner { background: #fff6dc; border: 1px solid #e3c766; border-radius: 8px; padding: 8px 10px; margin: 8px 0; font-size: .9rem; }
.kbd { font-family: ui-monospace, monospace; font-size: .8rem; background: #eee; border-radius: 3px; padding: 0 4px; }

/* Narrow screens (phones / small tablets) */
@media (max-width: 1000px) {
  #app { grid-template-columns: minmax(0, 1fr); padding: 6px; gap: 8px; }
  #proc { position: static; max-height: none; }
  #board { min-width: 0; }
}
@media (max-width: 640px) {
  :root { font-size: 16px; }
  #hdr { gap: 6px 12px; padding: 6px 8px; position: static; }
  #hdr .btns { margin-left: 0; }
  .tracks { grid-template-columns: minmax(0, 1fr); }
  .trk { flex-wrap: wrap; }
  .niag { flex-wrap: wrap; }
  #lake { grid-template-columns: repeat(2, minmax(0, 1fr)); grid-template-areas: "YOR NIA" "NOR SOU" "KIN SAC"; }
  button, button.small, #hdr .btns button, button.asg-ship, select { min-height: 36px; }
  button.primary, .sel-list label { min-height: 44px; }
  select, input:not([type="checkbox"]), textarea { font-size: 1rem; max-width: 100%; }
  .sel-list label { padding: 3px 2px; }
  .sel-list input[type="checkbox"] { width: 19px; height: 19px; flex-shrink: 0; }
  .turntrack span, .force .fh, .box .bl, .tcard, .tag, .ship .st { font-size: .78rem; }
  .tcard { max-width: 100%; }
  .ship { min-width: 0; max-width: 100%; font-size: .86rem; }
  .ship .nm { white-space: normal; }
  .niag span, .trk i { font-size: .75rem; }
  .trk i { width: 18px; height: 20px; line-height: 18px; }
  .ref td, .ref th { padding: 3px; }
  .tgt { overflow-x: auto; }
  .tgt td, .tgt th { font-size: .78rem; }
  .zone .tag.ev { min-height: 32px; text-align: left; }
  #proc .combat { grid-template-columns: minmax(0, 1fr); }
  .setup .camp { grid-template-columns: minmax(0, 1fr); }
  .panel { padding: 8px; }
}
#board { display: flex; flex-direction: column; gap: 12px; min-width: 0; }
.banner.recovery { background: #fdecea; border-color: #d9534f; }
.banner.recovery button { margin-top: 6px; }

.table-recap { margin: .4rem 0 .65rem; border: 1px solid #a9b6c3; border-radius: .35rem; padding: 0 .6rem; }
.table-recap summary { cursor: pointer; padding: .45rem 0; font-weight: 650; }
.table-recap ul { padding-inline-start: 1.2rem; }
.table-recap li, .table-recap .ptext { margin: .25rem 0 .5rem; }
.log-search-label { display: flex; flex-wrap: wrap; align-items: center; gap: .4rem; margin-bottom: .5rem; }
#log-search { width: 20rem; max-width: 100%; min-width: 0; }
.app-download { margin-top: .7rem; }
.event-entry label { display: block; font-weight: bold; margin-bottom: 6px; }
.event-entry input { width: 7rem; min-height: 44px; padding: 7px; font-size: 1.2rem; }

/* Public campaign map. HTML buttons keep the small-screen labels readable. */
.map-toolbar { display: flex; flex-wrap: wrap; align-items: center; gap: 6px 12px; }
.map-toolbar button { margin-left: auto; }
.map-key { font-size: .82rem; font-weight: bold; }
.map-help, .map-caption { font-size: .76rem; margin: 6px 0; line-height: 1.3; }
.map-stage { position: relative; width: 100%; aspect-ratio: 1000 / 640; min-height: 470px; border: 1px solid #b8bda7; border-radius: 9px; isolation: isolate; }
.map-water { position: absolute; inset: 0; width: 100%; height: 100%; border-radius: 9px; pointer-events: none; }
.map-routes { position: absolute; inset: 0; width: 100%; height: 100%; pointer-events: none; }
.map-route { stroke-linejoin: round; stroke-linecap: round; }
.map-geography { font: 18px Georgia, serif; letter-spacing: 3px; fill: #506d74; }
.map-route-badge { position: absolute; transform: translate(-50%, -50%); z-index: 2; width: 21px; height: 21px; border: 1px solid #465c67; border-radius: 50%; background: #fffdf8; color: var(--ink); text-align: center; line-height: 19px; font-size: .75rem; font-weight: bold; pointer-events: none; }
.map-zone, .map-port { position: absolute; transform: translate(-50%, -50%); width: 26%; }
.map-zone { border: 1px solid #789ca8; background: rgba(248,253,255,.94); border-radius: 7px; padding: 3px; text-align: center; box-shadow: 0 1px 3px #45646a22; }
.map-zone-name { display: block; width: 100%; border: 0; border-radius: 4px; background: transparent; font-weight: bold; font-size: .86rem; padding: 3px 1px; }
.map-fleet { display: block; width: 100%; margin-top: 3px; padding: 4px; text-align: left; line-height: 1.25; font-size: .75rem; border-radius: 4px; }
.map-fleet.US { color: #254c80; background: #e6effa; border-color: #5c80ad; }
.map-fleet.BR { color: #8d2420; background: #fbe9e7; border-color: #bc706b; }
.map-fleet strong, .map-missions { display: block; overflow-wrap: anywhere; }
.map-missions { font-size: .71rem; }
.map-empty, .map-zone-note { display: block; font-size: .71rem; margin: 2px 0; }
.map-empty { color: var(--muted); padding-bottom: 3px; }
.map-zone.map-control-US { border-bottom: 4px solid var(--us); }
.map-zone.map-control-BR { border-bottom: 4px solid var(--br); }
.map-encounter { outline: 2px dashed #9e6818; outline-offset: 3px; }
.map-port { width: 27%; padding: 4px 2px; font-size: .76rem; line-height: 1.25; background: #fffdf4; }
.map-port strong, .map-port span { display: block; }
.map-port.US { border-color: #5c80ad; color: #254c80; }
.map-port.BR { border-color: #bc706b; color: #8d2420; }
.map-escort { font-size: .68rem; padding: 2px; }
.map-moved { box-shadow: 0 0 0 3px #c39730, 0 2px 5px #374a5060; }
.map-action-summary { margin-top: 7px; font-size: .8rem; line-height: 1.4; overflow-wrap: anywhere; }
.map-action-summary ol { padding-left: 1.5rem; margin: 5px 0; }
.map-action-summary li { margin: 4px 0; }
.map-zone-list { margin-top: 8px; }
.map-zone-list > summary { cursor: pointer; padding: 7px 0; font-size: .86rem; font-weight: bold; }
.map-zone-details .zone { min-height: 0; }
@media (max-width: 640px) {
  .map-stage { min-height: 540px; }
  .map-zone { width: 28%; padding: 2px; }
  .map-zone-name { font-size: .78rem; padding: 2px 0; }
  .map-fleet { font-size: .68rem; padding: 3px 2px; }
  .map-missions, .map-empty, .map-zone-note { font-size: .65rem; }
  .map-port { width: 28%; font-size: .67rem; }
  .map-escort { font-size: .6rem; }
  .map-caption { font-size: .7rem; }
  #modal .map-dialog { min-width: 0; }
}

</style>
</head>
