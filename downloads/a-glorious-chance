      // Phase, so in a Lake Action Encounter the card is a plain Patrol (player ruling, Nov 2026).
      if (h === 'BR' && phase !== 'enemy') break;
      if (c && c.real && !s.convoyDeployed[h]) { sec(); why = 'your Convoy is running this turn'; }
      break;
